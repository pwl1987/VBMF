# ============================================
# VBMF .gitignore
# 覆盖: Node.js / Rust / Python / FFmpeg / IDE / OS
# ============================================

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Windows ----
# Windows thumbnail cache files
*.thumb
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# ---- macOS ----
.AppleDouble
.LSOverride
Icon

# Spotlight
._*
.Trashes

# ---- Linux ----
*~
.fuse_hidden*
.Trash-*

# ============================================
# Editors / IDEs
# ============================================

# ---- VS Code ----
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ---- JetBrains (IntelliJ, WebStorm, CLion, etc.) ----
.idea/
*.iml
*.iws
*.ipr
out/

# ---- Vim / Emacs ----
*~
\#*\#
.\#*
*.swp
*.swo
*\%\%\%
*\$*

# ---- Sublime Text ----
*.sublime-project
*.sublime-workspace

# ---- Visual Studio ----
.vs/
*.user
*.suo
*.sln
*.userprefs
*.sln.docstates
[Bb]uild[Ll]og.*
*.userosscache
*.suo
*.sln.docstates

# ============================================
# Build artifacts
# ============================================

# ---- Node / TypeScript ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
.next/
.nuxt/
.vuepress/dist/
.cache/
.parcel-cache/
dist/
build/
out/
coverage/
*.lcov
.nyc_output/

# ---- Rust ----
target/
**/*.rs.bk
Cargo.lock.bak
*.pdb

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
ruff_cache/

# ---- Go ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work.sum

# ---- Java / Kotlin / Scala ----
*.class
*.log
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ============================================
# Media / FFmpeg / BMD
# ============================================
# NOTE (Phase 0.5C 对账): 不可全局忽略 *.ts — 会吞掉 Phase 2 (Fastify/TS) 与
# Phase 4 (Web Console) 的全部 TypeScript 源码。MPEG-TS 媒体文件按目录忽略:
# recordings/ / segments/ / chunks/ (运行时输出) 与 /media/ (素材落盘目录)。

*.mp4
*.m3u8
*.mpd
*.mkv
*.mov
*.avi
*.flv
*.webm
*.wav
*.mp3
*.aac
*.opus
*.ogg
*.flac
*.h264
*.h265
*.hevc
*.av1
*.vp9
*.m4a
*.raw
*.yuv
*.rgb

# Recording segments
recordings/
segments/
chunks/
/media/

# BMD-specific
*.mov.bak

# ============================================
# Secrets / Config (NEVER commit)
# ============================================

.env
.env.local
.env.*.local
*.env
config.local.yaml
config.local.yml
config.local.json
secrets/
.secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# Database dumps
*.sql.gz
*.dump
*.bak
pgdata/

# ============================================
# Documentation build
# ============================================

# Sphinx
docs/_build/
docs/.doctrees/

# MkDocs
/site/

# Hugo
public/
.hugo_build.lock

# ============================================
# Logs / Runtime
# ============================================

logs/
*.log
*.log.*
*.pid
*.seed
*.pid.lock

# Prometheus / Grafana
prometheus_data/
grafana_data/

# ============================================
# Local data
# ============================================

data/
runtime_data/
tmp/
temp/
.cache/
