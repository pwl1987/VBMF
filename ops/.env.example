# VBMF Deployment Secrets Template (INFRA-SEC-01)
# Copy to .env and fill REAL values. .env is gitignored - NEVER commit real secrets.
# For ACCEPTANCE/PROD use dedicated .env.acceptance / .env.prod via SSH provisioning.

# PostgreSQL
POSTGRES_USER=vbmf
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vbmf

# RustFS (S3-compatible object storage)
RUSTFS_ACCESS=vbmf
RUSTFS_SECRET=CHANGE_ME_strong_secret
