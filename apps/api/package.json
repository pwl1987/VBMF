{
  "name": "@vbmf/api",
  "version": "0.1.0",
  "private": true,
  "description": "VBMF Control Plane (Fastify) — Product API /api/v1/* over the media-agent internal JSON-RPC Runtime Control surface",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:db": "node --test \"test/commands.db.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
