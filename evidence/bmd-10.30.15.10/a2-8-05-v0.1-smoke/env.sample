# v0.1 环境样例 —— 复制为本目录 .env 或直接 export 后运行 start.sh
# 必填: manifest 路径（生产绑定唯一权威; 缺失=失败闭合）
MEDIA_AGENT_DEVICE_BINDING=$HOME/a2-8-02i-v5.manifest.json

# 形态（v0.1 固定值, 勿改: 正常使用形态当前仅诊断模式可跑 — 缺口③）
MEDIA_AGENT_MODE=diagnostic
VBMF_DIAG_INPUTS=2

# 管理/健康面（默认仅本机回环; 生产经反向代理+认证暴露）
MEDIA_AGENT_HEALTH_BIND=127.0.0.1:8080

# 日志
RUST_LOG=info

# 可选: 输出物化（fail-soft, 未配置则仅观测面推进）
# VBMF_OUTPUT_KIND=hls
# VBMF_OUTPUT_HLS_DIR=/tmp/v0.1-hls
